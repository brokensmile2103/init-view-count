#: includes/settings-page.php:203
msgid "Delay before counting (ms)"
msgstr ""

#. translators: 1: minimum delay in ms, 2: maximum delay in ms
#: includes/settings-page.php:214
#, php-format
msgid "Minimum %1$dms, maximum %2$dms. 0 is not allowed to avoid counting views before the page has actually rendered."
msgstr ""

#: includes/settings-page.php:223
msgid "Scroll percent required"
msgstr ""

#. translators: 1: minimum scroll percent, 2: maximum scroll percent
#: includes/settings-page.php:234
#, php-format
msgid "Minimum %1$d%%, maximum %2$d%%. 0 is not allowed as it would bypass the scroll check entirely."
msgstr ""

#: includes/settings-page.php:243
msgid "Enable scroll check?"
msgstr ""

#: includes/settings-page.php:247
msgid "Only count views after user scrolls past required percent"
msgstr ""

#: includes/settings-page.php:252
msgid "Storage method"
msgstr ""

#: includes/settings-page.php:257
msgid "Session Storage"
msgstr ""

#: includes/settings-page.php:261
msgid "Local Storage"
msgstr ""

#: includes/settings-page.php:267
msgid "Batch view tracking"
msgstr ""

#: includes/settings-page.php:273
msgid "Number of views to collect before sending to server. Set to 1 for real-time tracking. Higher values reduce server requests but may miss some views if user leaves early."
msgstr ""

#: includes/settings-page.php:278
msgid "Reduce view count cache refreshes?"
msgstr ""

#: includes/settings-page.php:282
msgid "Refresh the cached metadata of each post at most once per interval, instead of after every single view."
msgstr ""

#: includes/settings-page.php:285
msgid "Refresh interval (seconds)"
msgstr ""

#. translators: 1: minimum interval in seconds, 2: maximum interval in seconds
#: includes/settings-page.php:297
#, php-format
msgid "Minimum %1$d seconds, maximum %2$d seconds."
msgstr ""

#: includes/settings-page.php:304
msgid "On busy sites, refreshing the cache after every view forces popular posts to reload all of their metadata from the database over and over. With this option on, every view is still written to the database immediately and accurately; only the cached copy is refreshed less often."
msgstr ""

#: includes/settings-page.php:307
#: includes/settings-page.php:420
msgid "Note:"
msgstr ""

#: includes/settings-page.php:308
msgid "Displayed view counts (shortcodes, blocks, rankings, Trending and the number shown right after a view is counted) may lag behind the real value by up to the interval above. A post that stops receiving views may keep showing a slightly lower number until it gets another view, is updated, or the daily reset runs (when daily views are enabled)."
msgstr ""

#: includes/settings-page.php:312
msgid "A persistent object cache is active on this site, so this option takes effect when enabled."
msgstr ""

#: includes/settings-page.php:314
msgid "No persistent object cache detected on this site, so this option currently has no effect."
msgstr ""

#: includes/settings-page.php:315
msgid "It only applies when a persistent object cache (Redis, Memcached, etc.) is in use; without one, cached metadata only lives for a single request."
msgstr ""

#: includes/settings-page.php:321
msgid "Enable strict IP check?"
msgstr ""

#: includes/settings-page.php:325
msgid "Stores a hashed list of recent IPs per post in a transient to prevent repeated views from the same IP within a short time window."
msgstr ""

#: includes/settings-page.php:328
msgid "Adds extra protection against bots or fake requests directly posting to the tracking endpoint. Useful if you see unusual traffic not blocked by countdown or scroll check."
msgstr ""

#: includes/settings-page.php:331
msgid "Performance note:"
msgstr ""

#: includes/settings-page.php:332
msgid "This check reads the transient on every view request and writes it back every time a view is counted. Without a persistent object cache (Redis, Memcached, etc.), transients are stored in the wp_options table, so each counted view adds up to two extra database writes. On busy sites without a persistent object cache, only enable it if you really need it."
msgstr ""

#: includes/settings-page.php:337
msgid "Require REST nonce verification?"
msgstr ""

#: includes/settings-page.php:341
msgid "Require a valid WordPress REST nonce (X-WP-Nonce) on every request to the /count endpoint."
msgstr ""

#: includes/settings-page.php:344
msgid "Blocks fake POST requests sent directly to the endpoint without loading the page first."
msgstr ""

#: includes/settings-page.php:347
msgid "Warning:"
msgstr ""

#: includes/settings-page.php:348
msgid "A WordPress nonce expires after roughly 12-24 hours. If you use full-page caching with a long lifetime, cached pages will keep serving an old, expired nonce, and view counting will silently stop working on those pages until the cache is refreshed. Leave this off on sites with long-lived page caching, or make sure the cache is purged/refreshed at least once a day."
msgstr ""

