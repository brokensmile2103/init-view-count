# --- Block metadata (block.json) — translated server-side via translate_settings_using_i18n_schema() ---
#: blocks/view-count/block.json
msgctxt "block title"
msgid "View Count"
msgstr "Số lượt xem"

#: blocks/view-count/block.json
msgctxt "block description"
msgid "Display the tracked view count for the current (or a specific) post."
msgstr "Hiển thị số lượt xem đã ghi nhận của bài viết hiện tại (hoặc một bài viết cụ thể)."

#: blocks/view-count/block.json blocks/view-list/block.json
#: blocks/view-ranking/block.json
msgctxt "block keyword"
msgid "views"
msgstr "lượt xem"

#: blocks/view-count/block.json
msgctxt "block keyword"
msgid "count"
msgstr "đếm"

#: blocks/view-count/block.json blocks/view-list/block.json
msgctxt "block keyword"
msgid "popular"
msgstr "phổ biến"

#: blocks/view-count/block.json blocks/view-ranking/block.json
msgctxt "block keyword"
msgid "trending"
msgstr "thịnh hành"

#: blocks/view-list/block.json
msgctxt "block title"
msgid "Popular Posts List"
msgstr "Danh sách bài viết phổ biến"

#: blocks/view-list/block.json
msgctxt "block description"
msgid ""
