# --- Abilities API + Block Editor (v1.23) ---
#: includes/abilities-api.php:37
msgid ""
"Read-only abilities for querying tracked post view counts and popular posts."
msgstr ""
"Các ability chỉ đọc để truy vấn lượt xem bài viết đã theo dõi và các bài "
"viết phổ biến."

#: includes/abilities-api.php:56
msgid "Get Post Views"
msgstr "Lấy lượt xem bài viết"

#: includes/abilities-api.php:57
msgid ""
"Returns the tracked view count for a single post (total, day, week, or "
"month). Read-only, does not increment the counter."
msgstr ""
"Trả về lượt xem đã ghi nhận của 1 bài viết (tổng, ngày, tuần hoặc tháng). "
"Chỉ đọc, không làm tăng bộ đếm."

#: includes/abilities-api.php:64
msgid "The ID of the post to look up."
msgstr "ID của bài viết cần tra cứu."

#: includes/abilities-api.php:69
msgid "Which counter to read."
msgstr "Bộ đếm nào cần đọc."

#: includes/abilities-api.php:81
msgid "The post ID that was looked up."
msgstr "ID bài viết đã được tra cứu."

#: includes/abilities-api.php:85
msgid "The counter field that was returned."
msgstr "Trường bộ đếm đã được trả về."

#: includes/abilities-api.php:89
msgid "Raw view count."
msgstr "Số lượt xem thô (chưa định dạng)."

#: includes/abilities-api.php:93
msgid "Locale-formatted view count (e.g. \"1,234\")."
msgstr "Lượt xem đã định dạng theo ngôn ngữ (VD: \"1.234\")."

#: includes/abilities-api.php:97
msgid "Abbreviated view count (e.g. \"1.2K\")."
msgstr "Lượt xem rút gọn (VD: \"1,2 N\")."

#: includes/abilities-api.php:117
msgid "Get Top Viewed Posts"
msgstr "Lấy danh sách bài viết xem nhiều nhất"

#: includes/abilities-api.php:118
msgid ""
"Returns a ranked list of the most viewed posts for a given time range "
"(total, day, week, month, or trending). Wraps the same data used by the "
"[init_view_ranking] shortcode and the GET /top REST route."
msgstr ""
"Trả về danh sách xếp hạng các bài viết xem nhiều nhất theo khoảng thời gian "
"(tổng, ngày, tuần, tháng, hoặc trending). Dùng lại đúng dữ liệu của "
"shortcode [init_view_ranking] và REST route GET /top."

#: includes/abilities-api.php:125
msgid "How many posts to return."
msgstr "Số lượng bài viết cần trả về."

#: includes/abilities-api.php:132
msgid "Pagination page number."
msgstr "Số trang phân trang."

#: includes/abilities-api.php:139
msgid "Post types to include."
msgstr "Các loại bài viết cần bao gồm."

#: includes/abilities-api.php:144
msgid "Time range to rank by."
msgstr "Khoảng thời gian dùng để xếp hạng."

#: includes/abilities-api.php:150
msgid ""
"\"minimal\" returns only id/title/link; \"full\" includes excerpt, "
"thumbnail, category, etc."
msgstr ""
"\"minimal\" chỉ trả về id/tiêu đề/link; \"full\" bao gồm cả tóm tắt, ảnh đại "
"diện, chuyên mục, v.v."

#: includes/abilities-api.php:156
msgid "Optional taxonomy slug to filter by."
msgstr "Slug taxonomy tùy chọn để lọc theo."

#: includes/abilities-api.php:160
msgid "Comma-separated term slugs or IDs, used together with \"tax\"."
msgstr ""
"Danh sách slug hoặc ID term, cách nhau bởi dấu phẩy, dùng chung với \"tax\"."

#: includes/abilities-api.php:164
msgid "Bypass the 5-minute result cache."
msgstr "Bỏ qua cache kết quả 5 phút."

#: includes/abilities-api.php:176
msgid "Post ID."
msgstr "ID bài viết."

#: includes/abilities-api.php:180
msgid "Post title."
msgstr "Tiêu đề bài viết."

#: includes/abilities-api.php:184
msgid "Post permalink."
msgstr "Đường dẫn tĩnh của bài viết."

#: includes/abilities-api.php:188
msgid "View count for the requested range."
msgstr "Lượt xem theo khoảng thời gian đã yêu cầu."

#: includes/abilities-api.php:224
msgid "Invalid or non-published post ID."
msgstr "ID bài viết không hợp lệ hoặc chưa được xuất bản."

#: includes/abilities-api.php:265
msgid "The view count REST layer is not available."
msgstr "Lớp REST của view count hiện không khả dụng."

#: includes/rest-api.php:45
msgid "Invalid or expired security token."
msgstr "Mã bảo mật không hợp lệ hoặc đã hết hạn."

#: includes/rest-api.php:125
msgid "Invalid post ID."
msgstr "ID bài viết không hợp lệ."

#: includes/rest-api.php:138
msgid "Not enabled for view counting."
msgstr "Chưa được bật đếm lượt xem."

#: includes/settings-page.php:6 includes/settings-page.php:75
msgid "Init View Count Settings"
msgstr "Cài đặt Init View Count"

#: includes/settings-page.php:67
msgid "Settings saved."
msgstr "Đã lưu cài đặt."

#: includes/settings-page.php:80
msgid "Post types to track views"
msgstr "Các loại bài viết cần theo dõi lượt xem"

#: includes/settings-page.php:93
msgid "Auto-insert shortcode into post content?"
msgstr "Tự động chèn shortcode vào nội dung bài viết?"

#: includes/settings-page.php:99
msgid "Do not auto-insert (manual shortcode only)"
msgstr "Không tự chèn (chỉ dùng shortcode thủ công)"

#: includes/settings-page.php:104
msgid "Insert before content"
msgstr "Chèn trước nội dung"

#: includes/settings-page.php:109
msgid "Insert after content"
msgstr "Chèn sau nội dung"

#: includes/settings-page.php:113
msgid ""
"Only applies to post types where view count is enabled. Developers can "
"always insert shortcode manually."
msgstr ""
"Chỉ áp dụng cho các post type đã bật đếm view. Lập trình viên luôn có thể "
"chèn thủ công bằng shortcode."

#: includes/settings-page.php:118
msgid "Enable daily views?"
msgstr "Bật theo dõi lượt xem theo ngày?"

#: includes/settings-page.php:122
msgid "Count and store views per day"
msgstr "Đếm và lưu lượt xem theo ngày"

#: includes/settings-page.php:127
msgid "Enable weekly views?"
msgstr "Bật theo dõi lượt xem theo tuần?"

#: includes/settings-page.php:131
msgid "Track total views by week"
msgstr "Theo dõi tổng lượt xem theo tuần"

#: includes/settings-page.php:136
msgid "Enable monthly views?"
msgstr "Bật theo dõi lượt xem theo tháng?"

#: includes/settings-page.php:140
msgid "Track total views by month"
msgstr "Theo dõi tổng lượt xem theo tháng"

#: includes/settings-page.php:145
msgid "Delay before counting (ms)"
msgstr "Thời gian trễ trước khi tính lượt xem (ms)"

#: includes/settings-page.php:149
msgid "Scroll percent required"
msgstr "Phần trăm cuộn trang yêu cầu"

#: includes/settings-page.php:153
msgid "Enable scroll check?"
msgstr "Bật kiểm tra cuộn trang?"

#: includes/settings-page.php:157
msgid "Only count views after user scrolls past required percent"
msgstr "Chỉ đếm khi người dùng cuộn vượt qua phần trăm yêu cầu"

#: includes/settings-page.php:162
msgid "Storage method"
msgstr "Phương thức lưu trữ"

#: includes/settings-page.php:167
msgid "Session Storage"
msgstr "Bộ nhớ phiên (Session)"

#: includes/settings-page.php:171
msgid "Local Storage"
msgstr "Bộ nhớ cục bộ (Local)"

#: includes/settings-page.php:177
msgid "Batch view tracking"
msgstr "Gộp lượt xem"

#: includes/settings-page.php:183
msgid ""
"Number of views to collect before sending to server. Set to 1 for real-time "
"tracking. Higher values reduce server requests but may miss some views if "
"user leaves early."
msgstr ""
"Số lượt xem cần gom lại trước khi gửi lên server. Đặt là 1 để theo dõi theo "
"thời gian thực. Giá trị cao hơn sẽ giảm số lượng request, nhưng có thể mất "
"lượt xem nếu người dùng rời khỏi trang trước khi gửi."

#: includes/settings-page.php:188
msgid "Enable strict IP check?"
msgstr "Bật kiểm tra IP nghiêm ngặt?"

#: includes/settings-page.php:192
msgid ""
"Stores a hashed list of recent IPs per post in a transient to prevent "
"repeated views from the same IP within a short time window."
msgstr ""
"Lưu danh sách IP đã mã hóa gần đây theo từng bài viết bằng transient để ngăn "
"lượt xem lặp lại từ cùng một IP trong khoảng thời gian ngắn."

#: includes/settings-page.php:195
msgid ""
"Adds extra protection against bots or fake requests directly posting to the "
"tracking endpoint. Useful if you see unusual traffic not blocked by "
"countdown or scroll check."
msgstr ""
"Thêm lớp bảo vệ chống bot hoặc yêu cầu giả mạo gửi thẳng đến endpoint đếm "
"view. Hữu ích nếu bạn phát hiện lưu lượng bất thường không bị chặn bởi "
"countdown hoặc kiểm tra cuộn trang."

#: includes/settings-page.php:200
msgid "Require REST nonce verification?"
msgstr "Yêu cầu xác thực nonce REST?"

#: includes/settings-page.php:204
msgid ""
"Require a valid WordPress REST nonce (X-WP-Nonce) on every request to the /"
"count endpoint."
msgstr ""
"Yêu cầu mỗi request gửi đến endpoint /count phải kèm nonce REST hợp lệ của "
"WordPress (X-WP-Nonce)."

#: includes/settings-page.php:207
msgid ""
"Blocks fake POST requests sent directly to the endpoint without loading the "
"page first."
msgstr ""
"Chặn các request POST giả mạo gửi thẳng đến endpoint mà không load trang "
"trước."

#: includes/settings-page.php:210
msgid "Warning:"
msgstr "Lưu ý:"

#: includes/settings-page.php:211
msgid ""
"A WordPress nonce expires after roughly 12-24 hours. If you use full-page "
"caching with a long lifetime, cached pages will keep serving an old, expired "
"nonce, and view counting will silently stop working on those pages until the "
"cache is refreshed. Leave this off on sites with long-lived page caching, or "
"make sure the cache is purged/refreshed at least once a day."
msgstr ""
"Nonce của WordPress hết hạn sau khoảng 12-24 giờ. Nếu site dùng full-page "
"cache với thời gian sống dài, các trang đã cache sẽ tiếp tục mang theo nonce "
"cũ đã hết hạn, khiến việc đếm view âm thầm ngừng hoạt động trên các trang đó "
"cho đến khi cache được làm mới. Nên để tắt tùy chọn này nếu site cache trang "
"trong thời gian dài, hoặc đảm bảo cache được xóa/làm mới ít nhất mỗi ngày "
"một lần."

#: includes/settings-page.php:216
msgid "Enable dashboard widget?"
msgstr "Bật widget bảng xếp hạng?"

#: includes/settings-page.php:220
msgid "Display top view ranking inside WordPress Dashboard."
msgstr "Hiển thị bảng xếp hạng lượt xem trong Bảng tin WordPress."

#: includes/settings-page.php:223
msgid "Uncheck to hide the widget for all users."
msgstr "Bỏ chọn để ẩn widget với tất cả người dùng."

#: includes/settings-page.php:228
msgid "Disable plugin CSS?"
msgstr "Tắt CSS của plugin?"

#: includes/settings-page.php:232
msgid "Disable built-in CSS output."
msgstr "Tắt CSS mặc định của plugin."

#: includes/settings-page.php:235
msgid ""
"Check this if you want to fully control the styling yourself. The plugin "
"will not enqueue any CSS."
msgstr ""
"Chọn nếu bạn muốn tự kiểm soát hoàn toàn phần giao diện. Plugin sẽ không tự "
"thêm bất kỳ CSS nào."

#: includes/settings-page.php:240
msgid "Disable Trending?"
msgstr "Tắt tính năng Trending?"

#: includes/settings-page.php:246
msgid "Completely turn off trending calculations and outputs."
msgstr "Tắt hoàn toàn việc tính toán và hiển thị Trending."

#: includes/settings-page.php:249
msgid "Check this to hard-disable trending."
msgstr "Đánh dấu để vô hiệu hóa Trending."

#: includes/settings-page.php:254
msgid "Save Settings"
msgstr "Lưu cài đặt"

