msgid "Init View Count"
msgstr "Init View Count"

msgid "Init View Count – Minimal, Accurate, Extensible"
msgstr "Init View Count – Tối giản, Chính xác, Mở rộng dễ dàng"

msgid "Lightweight plugin to track real post views with scroll & delay detection, smart ranking, and flexible shortcodes."
msgstr "Plugin nhẹ để theo dõi lượt xem bài viết thực bằng cách phát hiện cuộn trang & thời gian, xếp hạng thông minh và hỗ trợ shortcode linh hoạt."

msgid "Init View Count Settings"
msgstr "Cài đặt Init View Count"

msgid "Settings"
msgstr "Cài đặt"

msgid "Settings saved."
msgstr "Đã lưu cài đặt."

msgid "Post types to track views"
msgstr "Các loại bài viết cần theo dõi lượt xem"

msgid "Enable daily views?"
msgstr "Bật theo dõi lượt xem theo ngày?"

msgid "Enable weekly views?"
msgstr "Bật theo dõi lượt xem theo tuần?"

msgid "Enable monthly views?"
msgstr "Bật theo dõi lượt xem theo tháng?"

msgid "Delay before counting (ms)"
msgstr "Thời gian trễ trước khi tính lượt xem (ms)"

msgid "Scroll percent required"
msgstr "Phần trăm cuộn trang yêu cầu"

msgid "Enable scroll check?"
msgstr "Bật kiểm tra cuộn trang?"

msgid "Storage method"
msgstr "Phương thức lưu trữ"

msgid "Session Storage"
msgstr "Bộ nhớ phiên (Session)"

msgid "Local Storage"
msgstr "Bộ nhớ cục bộ (Local)"

msgid "Disable plugin CSS?"
msgstr "Tắt CSS của plugin?"

msgid "Save Settings"
msgstr "Lưu cài đặt"

msgid "All Time"
msgstr "Tất cả"

msgid "Today"
msgstr "Hôm nay"

msgid "This Week"
msgstr "Tuần này"

msgid "This Month"
msgstr "Tháng này"

msgid "Yesterday"
msgstr "Hôm qua"

msgid "Last Week"
msgstr "Tuần trước"

msgid "Last Month"
msgstr "Tháng trước"

msgid "No data found."
msgstr "Không có dữ liệu."

msgid "Failed to load data."
msgstr "Lỗi khi tải dữ liệu."

msgid "Disable built-in CSS output."
msgstr "Tắt CSS mặc định của plugin."

msgid "Check this if you want to fully control the styling yourself. The plugin will not enqueue any CSS."
msgstr "Chọn nếu bạn muốn tự kiểm soát hoàn toàn phần giao diện. Plugin sẽ không tự thêm bất kỳ CSS nào."

msgid "Popular Posts"
msgstr "Bài viết nổi bật"

msgid "views"
msgstr "lượt xem"

msgid "Copy"
msgstr "Sao chép"

msgid "Copied!"
msgstr "Đã sao chép!"

msgid "Close"
msgstr "Đóng"

msgid "Shortcode Preview"
msgstr "Xem trước Shortcode"

msgid "Shortcode Builder"
msgstr "Trình tạo Shortcode"

msgid "Type"
msgstr "Loại"

msgid "Title"
msgstr "Tiêu đề"

msgid "Number of Posts"
msgstr "Số lượng bài viết"

msgid "Template"
msgstr "Giao diện"

msgid "View Range"
msgstr "Khoảng thời gian"

msgid "Post Type"
msgstr "Loại bài viết"

msgid "Category"
msgstr "Chuyên mục"

msgid "Tag"
msgstr "Thẻ"

msgid "Order By"
msgstr "Sắp xếp theo"

msgid "Order Direction"
msgstr "Thứ tự sắp xếp"

msgid "Custom CSS class"
msgstr "Class CSS tùy chỉnh"

msgid "Field"
msgstr "Trường dữ liệu"

msgid "Format"
msgstr "Định dạng"

msgid "Show Time Diff"
msgstr "Hiển thị thời gian đăng"

msgid "Tabs"
msgstr "Các tab"

msgid "Posted %s ago"
msgstr "Đăng %s trước"

msgid "Batch view tracking"
msgstr "Gộp lượt xem"

msgid "Number of views to collect before sending to server. Set to 1 for real-time tracking. Higher values reduce server requests but may miss some views if user leaves early."
msgstr "Số lượt xem cần gom lại trước khi gửi lên server. Đặt là 1 để theo dõi theo thời gian thực. Giá trị cao hơn sẽ giảm số lượng request, nhưng có thể mất lượt xem nếu người dùng rời khỏi trang trước khi gửi."

msgid "Invalid post ID."
msgstr "ID bài viết không hợp lệ."

msgid "Not enabled for view counting."
msgstr "Chưa được bật đếm lượt xem."

msgid "Invalid or expired security token."
msgstr "Mã bảo mật không hợp lệ hoặc đã hết hạn."

msgid "Enable strict IP check?"
msgstr "Bật kiểm tra IP nghiêm ngặt?"

msgid "Adds extra protection against bots or fake requests directly posting to the tracking endpoint. Useful if you see unusual traffic not blocked by countdown or scroll check."
msgstr "Thêm lớp bảo vệ chống bot hoặc yêu cầu giả mạo gửi thẳng đến endpoint đếm view. Hữu ích nếu bạn phát hiện lưu lượng bất thường không bị chặn bởi countdown hoặc kiểm tra cuộn trang."

msgid "Stores a hashed list of recent IPs per post in a transient to prevent repeated views from the same IP within a short time window."
msgstr "Lưu danh sách IP đã mã hóa gần đây theo từng bài viết bằng transient để ngăn lượt xem lặp lại từ cùng một IP trong khoảng thời gian ngắn."

msgid "Require REST nonce verification?"
msgstr "Yêu cầu xác thực nonce REST?"

msgid "Require a valid WordPress REST nonce (X-WP-Nonce) on every request to the /count endpoint."
msgstr "Yêu cầu mỗi request gửi đến endpoint /count phải kèm nonce REST hợp lệ của WordPress (X-WP-Nonce)."

msgid "Blocks fake POST requests sent directly to the endpoint without loading the page first."
msgstr "Chặn các request POST giả mạo gửi thẳng đến endpoint mà không load trang trước."

msgid "Warning:"
msgstr "Lưu ý:"

msgid "A WordPress nonce expires after roughly 12-24 hours. If you use full-page caching with a long lifetime, cached pages will keep serving an old, expired nonce, and view counting will silently stop working on those pages until the cache is refreshed. Leave this off on sites with long-lived page caching, or make sure the cache is purged/refreshed at least once a day."
msgstr "Nonce của WordPress hết hạn sau khoảng 12-24 giờ. Nếu site dùng full-page cache với thời gian sống dài, các trang đã cache sẽ tiếp tục mang theo nonce cũ đã hết hạn, khiến việc đếm view âm thầm ngừng hoạt động trên các trang đó cho đến khi cache được làm mới. Nên để tắt tùy chọn này nếu site cache trang trong thời gian dài, hoặc đảm bảo cache được xóa/làm mới ít nhất mỗi ngày một lần."

msgid "Enable dashboard widget?"
msgstr "Bật widget bảng xếp hạng?"

msgid "Display top view ranking inside WordPress Dashboard."
msgstr "Hiển thị bảng xếp hạng lượt xem trong Bảng tin WordPress."

msgid "Uncheck to hide the widget for all users."
msgstr "Bỏ chọn để ẩn widget với tất cả người dùng."

msgid "Count and store views per day"
msgstr "Đếm và lưu lượt xem theo ngày"

msgid "Track total views by week"
msgstr "Theo dõi tổng lượt xem theo tuần"

msgid "Track total views by month"
msgstr "Theo dõi tổng lượt xem theo tháng"

msgid "Only count views after user scrolls past required percent"
msgstr "Chỉ đếm khi người dùng cuộn vượt qua phần trăm yêu cầu"

msgid "Auto-insert shortcode into post content?"
msgstr "Tự động chèn shortcode vào nội dung bài viết?"

msgid "Do not auto-insert (manual shortcode only)"
msgstr "Không tự chèn (chỉ dùng shortcode thủ công)"

msgid "Insert before content"
msgstr "Chèn trước nội dung"

msgid "Insert after content"
msgstr "Chèn sau nội dung"

msgid "Only applies to post types where view count is enabled. Developers can always insert shortcode manually."
msgstr "Chỉ áp dụng cho các post type đã bật đếm view. Lập trình viên luôn có thể chèn thủ công bằng shortcode."

msgid "Show Icon"
msgstr "Hiện biểu tượng"

msgid "Enable Schema.org"
msgstr "Bật hỗ trợ Schema.org"

msgid "Custom Class"
msgstr "Lớp CSS tùy chỉnh"

msgid "Disable Trending?"
msgstr "Tắt tính năng Trending?"

msgid "Completely turn off trending calculations and outputs."
msgstr "Tắt hoàn toàn việc tính toán và hiển thị Trending."

msgid "Check this to hard-disable trending."
msgstr "Đánh dấu để vô hiệu hóa Trending."

# --- Abilities API + Block Editor (v1.23) ---
#: includes/abilities-api.php:36
msgid "Read-only abilities for querying tracked post view counts and popular posts."
msgstr "Các ability chỉ đọc để truy vấn lượt xem bài viết đã theo dõi và các bài viết phổ biến."

#: includes/abilities-api.php:55
msgid "Get Post Views"
msgstr "Lấy lượt xem bài viết"

#: includes/abilities-api.php:56
msgid "Returns the tracked view count for a single post (total, day, week, or month). Read-only, does not increment the counter."
msgstr "Trả về lượt xem đã ghi nhận của 1 bài viết (tổng, ngày, tuần hoặc tháng). Chỉ đọc, không làm tăng bộ đếm."

#: includes/abilities-api.php:63
msgid "The ID of the post to look up."
msgstr "ID của bài viết cần tra cứu."

#: includes/abilities-api.php:68
msgid "Which counter to read."
msgstr "Bộ đếm nào cần đọc."

#: includes/abilities-api.php:80
msgid "The post ID that was looked up."
msgstr "ID bài viết đã được tra cứu."

#: includes/abilities-api.php:84
msgid "The counter field that was returned."
msgstr "Trường bộ đếm đã được trả về."

#: includes/abilities-api.php:88
msgid "Raw view count."
msgstr "Số lượt xem thô (chưa định dạng)."

#: includes/abilities-api.php:92
msgid "Locale-formatted view count (e.g. \"1,234\")."
msgstr "Lượt xem đã định dạng theo ngôn ngữ (VD: \"1.234\")."

#: includes/abilities-api.php:96
msgid "Abbreviated view count (e.g. \"1.2K\")."
msgstr "Lượt xem rút gọn (VD: \"1,2 N\")."

#: includes/abilities-api.php:116
msgid "Get Top Viewed Posts"
msgstr "Lấy danh sách bài viết xem nhiều nhất"

#: includes/abilities-api.php:117
msgid "Returns a ranked list of the most viewed posts for a given time range (total, day, week, month, or trending). Wraps the same data used by the [init_view_ranking] shortcode and the GET /top REST route."
msgstr "Trả về danh sách xếp hạng các bài viết xem nhiều nhất theo khoảng thời gian (tổng, ngày, tuần, tháng, hoặc trending). Dùng lại đúng dữ liệu của shortcode [init_view_ranking] và REST route GET /top."

#: includes/abilities-api.php:124
msgid "How many posts to return."
msgstr "Số lượng bài viết cần trả về."

#: includes/abilities-api.php:131
msgid "Pagination page number."
msgstr "Số trang phân trang."

#: includes/abilities-api.php:138
msgid "Post types to include."
msgstr "Các loại bài viết cần bao gồm."

#: includes/abilities-api.php:143
msgid "Time range to rank by."
msgstr "Khoảng thời gian dùng để xếp hạng."

#: includes/abilities-api.php:149
msgid "\"minimal\" returns only id/title/link; \"full\" includes excerpt, thumbnail, category, etc."
msgstr "\"minimal\" chỉ trả về id/tiêu đề/link; \"full\" bao gồm cả tóm tắt, ảnh đại diện, chuyên mục, v.v."

#: includes/abilities-api.php:155
msgid "Optional taxonomy slug to filter by."
msgstr "Slug taxonomy tùy chọn để lọc theo."

#: includes/abilities-api.php:159
msgid "Comma-separated term slugs or IDs, used together with \"tax\"."
msgstr "Danh sách slug hoặc ID term, cách nhau bởi dấu phẩy, dùng chung với \"tax\"."

#: includes/abilities-api.php:163
msgid "Bypass the 5-minute result cache."
msgstr "Bỏ qua cache kết quả 5 phút."

#: includes/abilities-api.php:175
msgid "Post ID."
msgstr "ID bài viết."

#: includes/abilities-api.php:179
msgid "Post title."
msgstr "Tiêu đề bài viết."

#: includes/abilities-api.php:183
msgid "Post permalink."
msgstr "Đường dẫn tĩnh của bài viết."

#: includes/abilities-api.php:187
msgid "View count for the requested range."
msgstr "Lượt xem theo khoảng thời gian đã yêu cầu."

#: includes/abilities-api.php:223
msgid "Invalid or non-published post ID."
msgstr "ID bài viết không hợp lệ hoặc chưa được xuất bản."

#: includes/abilities-api.php:264
msgid "The view count REST layer is not available."
msgstr "Lớp REST của view count hiện không khả dụng."

