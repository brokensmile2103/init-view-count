{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "init-view-count/view-count",
    "title": "View Count",
    "category": "init-view-count",
    "icon": "visibility",
    "description": "Display the tracked view count for the current (or a specific) post.",
    "keywords": ["views", "count", "popular", "trending"],
    "textdomain": "init-view-count",
    "attributes": {
        "postId": {
            "type": "number",
            "default": 0
        },
        "field": {
            "type": "string",
            "default": "total"
        },
        "format": {
            "type": "string",
            "default": "formatted"
        },
        "showTime": {
            "type": "boolean",
            "default": false
        },
        "showIcon": {
            "type": "boolean",
            "default": false
        },
        "showSchema": {
            "type": "boolean",
            "default": false
        }
    },
    "usesContext": ["postId"],
    "supports": {
        "html": false,
        "align": ["left", "center", "right"],
        "spacing": {
            "margin": true
        }
    },
    "editorScript": "init-view-count-blocks-editor",
    "style": "init-plugin-suite-view-count-style",
    "render": "file:./render.php"
}
